# =========================================================
# CONTOH ENVIRONMENT VARIABLES
# Salin file ini menjadi .env dan isi nilainya
# =========================================================

# ---------- Supabase (produksi) ----------
# Project URL (Settings -> API)
SUPABASE_URL=
# anon public key
SUPABASE_ANON_KEY=

# ---------- Google Drive File IDs (OPSIONAL) ----------
# CARA PALING MUDAH: isi File ID di Supabase Dashboard
#   Table Editor -> exams -> kolom drive_file_id
#   (tidak perlu edit kode / env var / redeploy)
#
# Env var di bawah hanya fallback. Nama = DRIVE_ID_<KEY>
# KEY sama dengan exam_key di server/config.js.
# Kosongkan jika memakai tabel exams di Supabase.
DRIVE_ID_AGAMA=
DRIVE_ID_PPKN=
DRIVE_ID_INDONESIA=
DRIVE_ID_MATEMATIKA=
DRIVE_ID_IPA=
DRIVE_ID_IPS=
DRIVE_ID_INGGRIS=
DRIVE_ID_SENI=
DRIVE_ID_PJOK=
DRIVE_ID_PRAKARYA=
DRIVE_ID_INFORMATIKA=
DRIVE_ID_MULOK_BAHASA_DAERAH=
DRIVE_ID_MULOK_BAHASA_ASING=
DRIVE_ID_PENDALAMAN_AGAMA=
DRIVE_ID_BK=
DRIVE_ID_LITERASI=
DRIVE_ID_KEWIRAUSAHAAN=
DRIVE_ID_MATEMATIKA_TAMBAHAN=
DRIVE_ID_IPA_TAMBAHAN=
DRIVE_ID_IPS_TAMBAHAN=